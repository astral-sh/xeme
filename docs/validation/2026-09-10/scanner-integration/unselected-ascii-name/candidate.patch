+    let suffix = &text[offset..];
+    let mut index = 0;
+    while let Some(&byte) = suffix.as_bytes().get(index) {
+        if byte.is_ascii() {
+            if !byte.is_ascii_alphanumeric() && !matches!(byte, b':' | b'_' | b'-' | b'.') {
+                break;
