{
  "steps": [
    {
      "label": "compile",
      "argv": [
        "/usr/bin/x86_64-linux-gnu-gcc-13",
        "-O1",
        "-DXML_TESTING",
        "-D_GNU_SOURCE",
        "-I/tmp/oriole-core-owned-text-raw-buffer-tail/adapted",
        "-I/tmp/oriole-core-owned-text-raw-buffer-tail/lib",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/acc_tests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/alloc_tests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/basic_tests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/bridge.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/chardata.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/common.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/dummy.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/handlers.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/memcheck.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/minicheck.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/misc_tests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/ns_tests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/nsalloc_tests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/runtests.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/adapted/structdata.c",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/liboriole_expat.so",
        "-Wl,-rpath,/tmp/oriole-core-owned-text-raw-buffer-tail",
        "-lm",
        "-ldl",
        "-o",
        "/tmp/oriole-core-owned-text-raw-buffer-tail/run01/runtests"
      ],
      "timeout_seconds": 120,
      "log": "build.log"
    },
    {
      "label": "diagnostic",
      "argv": [
        "/tmp/oriole-core-owned-text-raw-buffer-tail/run01/runtests",
        "--verbose"
      ],
      "timeout_seconds": 240,
      "log": "tests.log"
    }
  ],
  "environment": {
    "PATH": "/usr/bin:/bin",
    "LANG": "C",
    "LC_ALL": "C",
    "TMPDIR": "/tmp",
    "ORIOLE_CHUNK_MASK": "63",
    "ORIOLE_DEFERRAL_MASK": "3",
    "ORIOLE_TEST_TIMEOUT": "3",
    "ORIOLE_MEMORY_MIB": "1024",
    "ORIOLE_RSS_MIB": "768",
    "ORIOLE_SELECTED_TESTS": "test_nsalloc_parse_buffer"
  }
}
