+                            return Err(Error::bare(
+                                ErrorKind::UnknownEncoding,
+                                "unsupported declared encoding",
+                            ));
+                        }
+                        return Ok(encoding.map(|encoding| (encoding, skip)));
+                    }
+                }
+            }
+        }
+        Ok(Some((Encoding::Utf8, skip)))
+    }
