+        assert_eq!(
+            namespace_starts(&mut parser, &mut frame),
+            [
+                ("s".into(), None),
+                ("n".into(), None),
+                ("urn:a|n".into(), None),
+            ]
+        );
+        assert_eq!(parser.default_namespace_revision, None);
+        assert_eq!(frame.namespace_default_revision, None);
+        parser.finish_adapter_frame(frame);
+    }
