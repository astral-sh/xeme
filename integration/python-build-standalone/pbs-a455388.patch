+def install_oriole_overlay(
+    build_env, host_platform, target_triple, python_version, build_options
+):
+    """Install an explicitly selected archive only in this CPython build container."""
+    location = os.environ.get("PYBUILD_ORIOLE_BUNDLE")
+    if not location:
+        return
+    cpu_targets = {"x86_64-unknown-linux-gnu": None, "x86_64_v3-unknown-linux-gnu": "x86-64-v3"}
+    if (
+        host_platform != "linux_x86_64"
+        or platform.system() != "Linux"
+        or target_triple not in cpu_targets
+        or python_version != "3.12.13"
+        or "static" in build_options.split("+")
+        or not build_env.is_isolated
+    ):
+        raise ValueError(
+            "Oriole overlay requires Linux x86_64 Docker, CPython 3.12.13, and a shared Python build"
+        )
+    bundle = pathlib.Path(location).resolve()
+    manifest = json.loads((bundle / "manifest.json").read_text())
+    target_cpu = cpu_targets[target_triple]
+    rustflags = "-C relocation-model=pic -C panic=unwind"
+    if target_cpu:
+        rustflags += f" -C target-cpu={target_cpu}"
+    if (
+        manifest.get("format") != 1
+        or manifest.get("target") != target_triple
+        or manifest.get("rust_target") != "x86_64-unknown-linux-gnu"
+        or "target_cpu" not in manifest
+        or manifest["target_cpu"] != target_cpu
+        or manifest.get("rustflags") != rustflags
+        or manifest.get("pbs_revision") != "a4553880293fe9d1bb62747d34ab0e5121d3554f"
+    ):
+        raise ValueError("Oriole bundle target or recipe revision does not match")
+    destinations = {
+        "libexpat.a": ("/tools/deps/lib", "libexpat.a"),
+        "expat.h": ("/tools/deps/include", "expat.h"),
+        "expat.pc": ("/tools/deps/lib/pkgconfig", "expat.pc"),
+        "native-static-libs.txt": ("/tools/deps/lib", "oriole-native-static-libs.txt"),
+        "LICENSE.oriole.txt": ("/build", "LICENSE.oriole.txt"),
+        "cpython-external-parser.patch": ("/tools/deps/share/oriole", "cpython-external-parser.patch"),
+    }
+    for name in destinations:
+        if (
+            hashlib.sha256((bundle / name).read_bytes()).hexdigest()
+            != manifest["files"][name]
+        ):
+            raise ValueError(f"Oriole bundle checksum mismatch: {name}")
+    native = (bundle / "native-static-libs.txt").read_text().split()
+    if not native or any(
+        re.fullmatch(r"-l[A-Za-z0-9_]+", flag) is None for flag in native
+    ):
+        raise ValueError("Oriole native linker flags require review")
+    build_env.run(["mkdir", "-p", "/tools/deps/include", "/tools/deps/lib/pkgconfig", "/tools/deps/share/oriole"])
+    for name, (directory, installed_name) in destinations.items():
+        build_env.copy_file(
+            bundle / name, dest_path=directory, dest_name=installed_name
+        )
+    # Preserve build provenance in the distribution's existing license directory.
+    build_env.copy_file(
+        bundle / "manifest.json",
+        dest_path="/build",
+        dest_name="LICENSE.oriole-build.txt",
+    )
+    DOWNLOADS["expat"] = {
+        **DOWNLOADS["expat"],
+        "licenses": ["MIT", "Apache-2.0"],
+        "license_file": "LICENSE.oriole.txt",
+    }
